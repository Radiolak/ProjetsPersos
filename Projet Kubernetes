# 1. Les 3 Pods applicatifs (votre code)
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nodejs-deployment
spec:
  replicas: 3 # 👈 C'est ici qu'on demande 3 pods applicatifs !
  selector:
    matchLabels:
      app: nodejs-app
  template:
    metadata:
      labels:
        app: nodejs-app
    spec:
      containers:
        - name: nodejs-container
          image: node:18-alpine 
          resources: 
		requests: 
			memory: "128Mi" 
			cpu: "100m" 
		limits:
			memory: "256Mi" 
			cpu: "200m"
          ports:
            - containerPort: 3000
          env:
            - name: DB_HOST
              value: "postgres-service" # Se connecte au nom du service du fichier 1
            - name: DB_PASSWORD
              value: "MonMotDePasseSecret"
---
# 2. Le Load Balancer pour ouvrir l'accès vers l'extérieur
apiVersion: v1
kind: Service
metadata:
  name: mon-load-balancer
spec:
  type: LoadBalancer # 👈 Demande à K3s de créer un Load Balancer
  selector:
    app: nodejs-app # Redirige les gens vers les pods qui ont ce label
  ports:
    - port: 80         # Le port que vous allez taper sur votre PC (ex: http://192.168.1.50)
      targetPort: 3000 # Le port sur lequel l'application tourne dans le conteneur
